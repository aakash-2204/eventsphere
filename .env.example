# EventSphere environment variables
#
# 1. Copy this file to .env.local   (cp .env.example .env.local)
# 2. Replace the placeholder values with your own from the Supabase dashboard:
#    Project Settings -> API Keys / Data API
# 3. Restart `npm run dev`
#
# .env.local is ignored by git, so your real values never get committed.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (starts with sb_publishable_...) or, on older projects,
# the "anon public" key. This is safe in the browser because Row Level
# Security decides what it can access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The address of this app, used in email links.
# Local: http://localhost:3000   Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do NOT add the service-role / secret key in Phase 2. It bypasses all
# security rules. If a later phase needs it, it must be a server-only
# variable (no NEXT_PUBLIC_ prefix) and must never be imported by browser code.
